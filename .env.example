# Copy to `.env` in this directory (Compose reads it automatically).
# `.env` is gitignored.

# Browser origin — must match the address bar (no trailing slash).
# Port 80:  http://203.0.113.10
# Other:    http://203.0.113.10:8080
PUBLIC_ORIGIN=http://YOUR.SERVER.IP

WEB_PORT=80

DATABASE_USER=postgres
DATABASE_PASSWORD=change-me-db-password
DATABASE_NAME=vue_nestjs_admin_template

JWT_SECRET=change-me-jwt-secret
JWT_REFRESH_SECRET=change-me-jwt-refresh-secret
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d

# HTTP IP test: false. HTTPS later: true.
COOKIE_SECURE=false

BOOTSTRAP_ADMIN_EMAIL=super-admin@localhost.ir
BOOTSTRAP_ADMIN_PASSWORD=change-me-admin-password
BOOTSTRAP_ADMIN_NAME=super-admin

# Copy this file to `.env` in the repo root. Compose reads `.env` only —
# `.env.example` is not loaded. pgAdmin uses these values on the *first*
# volume create; later password changes need `docker compose down -v`.
PGADMIN_DEFAULT_EMAIL=admin@localhost.ir
PGADMIN_DEFAULT_PASSWORD=admin
