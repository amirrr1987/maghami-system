# Copy to `.env` in this directory (gitignored).
# Compose and Nest both read this file. `.env.example` is never loaded.
#
# `docker-compose.yml` overrides DATABASE_HOST inside the API container.
# Keep DATABASE_HOST=localhost here for `pnpm dev`.
#
# Optional leftover: `apps/api/.env` is still loaded for keys missing here.
# Prefer this root file only (move values here, then delete `apps/api/.env`).

# --- Database (Postgres) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=vue_nestjs_admin_template
TYPEORM_SYNC=true

# --- Nest API ---
PORT=3000
CORS_ORIGIN=http://localhost:5173
UPLOAD_DIR=uploads

# --- Auth (JWT + refresh cookie) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_REFRESH_EXPIRES_IN=7d
# true behind HTTPS. false for HTTP / IP testing (even if NODE_ENV=production).
COOKIE_SECURE=false
# REFRESH_COOKIE_PATH=/

# --- App login (Vue) — not pgAdmin ---
BOOTSTRAP_ADMIN_EMAIL=super-admin@localhost.ir
BOOTSTRAP_ADMIN_PASSWORD=UTMwBgi6vcpsXZc
BOOTSTRAP_ADMIN_NAME=super-admin

# --- pgAdmin (http://localhost:5173/pgadmin4 or :5050/pgadmin4) ---
# Applied only on first volume create. To reset: docker compose down -v
PGADMIN_DEFAULT_EMAIL=admin@localhost.ir
PGADMIN_DEFAULT_PASSWORD=admin

# --- Docker Compose ports (local full stack) ---
WEB_PORT=5173
# PGADMIN_PORT=5050

# --- VPS (`docker-compose.server.yml`) ---
# Must match the browser address bar (no trailing slash).
# Port 80:  http://203.0.113.10
PUBLIC_ORIGIN=http://YOUR.SERVER.IP
# WEB_PORT=80

# --- Bruno ---
# Bruno does not read this file. Copy bruno/.env.example → bruno/.env
